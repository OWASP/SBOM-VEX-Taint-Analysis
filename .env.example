# LLM Backend (OpenAI-compatible endpoint: vLLM or Ollama)
VLLM_BASE_URL=http://localhost:8000/v1    # or Ollama: http://localhost:11434/v1
LLM_MODEL=Qwen2.5-Coder-32B-Instruct      # or llama3.1 for dev
